# Supabase プロジェクトの Project URL（Settings > API）
SUPABASE_URL=

# Supabase の anon key（Settings > API）
SUPABASE_ANON_KEY=

# Supabase の service_role key（Settings > API）
# RLSを完全にバイパスする強い権限のため、通常のAPIリクエスト処理では使わない。
# 現状ではアラート再計算バッチ(STEP11, POST /alerts/recompute)でのみ使用する。
# 未設定でもアプリは起動できるが、その場合アラート再計算機能のみ無効になる。
# ※ フロントエンド/リポジトリには絶対に含めない。このファイル(.env)はgitignore対象。
SUPABASE_SERVICE_ROLE_KEY=

# NestJS のリッスンポート（省略時は 3000）
PORT=3000

# フロントエンド(Next.js)からのブラウザ経由アクセスを許可するオリジン（カンマ区切りで複数可）
# 省略時は開発用の http://localhost:3001 のみ許可される
CORS_ORIGINS=http://localhost:3001
